<?xml version="1.0" encoding="utf-8"?>
<!--
  Painéis locais (HTTP) são comuns em TV Box / intranet.
  Tráfego externo continua sujeito às regras padrão do Android.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
